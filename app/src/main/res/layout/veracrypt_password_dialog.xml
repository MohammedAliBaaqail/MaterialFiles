<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/abc_dialog_title_divider_material">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
 
         <com.google.android.material.textfield.TextInputLayout
             android:id="@+id/passwordLayout"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginStart="?dialogPreferredPadding"
             android:layout_marginEnd="?dialogPreferredPadding"
             android:layout_marginTop="4dp"
             app:passwordToggleEnabled="true">
 
             <com.google.android.material.textfield.TextInputEditText
                 android:id="@+id/passwordEdit"
                 android:layout_width="match_parent"
                 android:layout_height="wrap_content"
                 android:hint="@string/ftp_server_password_title"
                 android:inputType="textPassword" />
         </com.google.android.material.textfield.TextInputLayout>
 
         <TextView
             android:id="@+id/timeoutText"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:layout_marginStart="?dialogPreferredPadding"
             android:layout_marginEnd="?dialogPreferredPadding"
             android:layout_marginTop="16dp"
             android:text="Session Timeout: 1 hour"
             android:textAppearance="@style/TextAppearance.MaterialComponents.Body2" />
 
         <com.google.android.material.slider.Slider
             android:id="@+id/timeoutSlider"
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:layout_marginStart="8dp"
             android:layout_marginEnd="8dp"
             android:valueFrom="1"
             android:valueTo="24"
             android:stepSize="1"
             android:value="1" />
     </LinearLayout>
</FrameLayout>
